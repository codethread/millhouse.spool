{:paths ["scripts"]
 :deps
 {io.millstrand/millstrand
  {:git/url "https://github.com/codethread/millstrand.git"
   :git/sha "71c0ed3d80fcad090b74a704a8eb165a3fad996e"
   :deps/root "."}
  millhouse.spools/chime {:local/root "spools/chime"}
  millhouse.spools/cron {:local/root "spools/cron"}
  millhouse.spools/identity {:local/root "spools/identity"}
  millhouse.spools/kanban {:local/root "spools/kanban"}
  millhouse.spools/workflow {:local/root "spools/workflow"}}
 :aliases
 {:format
  {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.13.1"}}
   :main-opts
   ["-m" "cljfmt.main" "check"
    "scripts" "test"
    "spools/chime/src" "spools/chime/test"
    "spools/cron/src" "spools/cron/test"
    "spools/identity/src" "spools/identity/test"
    "spools/kanban/src" "spools/kanban/test"
    "spools/workflow/src" "spools/workflow/test"]}
  :format/fix
  {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.13.1"}}
   :main-opts
   ["-m" "cljfmt.main" "fix"
    "scripts" "test"
    "spools/chime/src" "spools/chime/test"
    "spools/cron/src" "spools/cron/test"
    "spools/identity/src" "spools/identity/test"
    "spools/kanban/src" "spools/kanban/test"
    "spools/workflow/src" "spools/workflow/test"]}
  :api-docs
  {:extra-deps
   {io.github.borkdude/quickdoc {:git/tag "v0.2.6" :git/sha "ce86780"}}
   :main-opts ["scripts/generate_api_docs.clj"]}
  :reflect-check
  {:extra-paths
   ["test"
    "spools/chime/test"
    "spools/cron/test"
    "spools/identity/test"
    "spools/kanban/test"
    "spools/workflow/test"]
   :main-opts ["-m" "quality.reflect-check"]}
  :lint/conventions
  {:extra-paths
   ["test"
    "spools/chime/test"
    "spools/cron/test"
    "spools/identity/test"
    "spools/kanban/test"
    "spools/workflow/test"]
   :extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
   :main-opts ["-m" "quality.conventions-check"]}
  :lint/splint
  {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.21.0"}}
   :main-opts
   ["-m" "noahtheduke.splint" "--output" "clj-kondo"
    "scripts" "test"
    "spools/chime/src" "spools/chime/test"
    "spools/cron/src" "spools/cron/test"
    "spools/identity/src" "spools/identity/test"
    "spools/kanban/src" "spools/kanban/test"
    "spools/workflow/src" "spools/workflow/test"]}
  :test
  {:extra-paths
   ["test"
    "spools/chime/test"
    "spools/cron/test"
    "spools/identity/test"
    "spools/kanban/test"
    "spools/workflow/test"]
   :extra-deps {org.clojure/data.json {:mvn/version "2.5.1"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "millhouse.test-runner"]}}}
